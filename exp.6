      "cell_type": "code",
      "source": [
        "volatile_sources = ['RAM', 'Cache', 'Running Processes', 'Network Connections']\n",
        "\n",
        "def classify(source):\n",
        "    if source in volatile_sources:\n",
        "        return 'Volatile'\n",
        "    else:\n",
        "        return 'Non-Volatile'\n",
        "\n",
        "evidence_sources = ['RAM', 'Hard Disk', 'Cache', 'Registry Files']\n",
        "for src in evidence_sources:\n",
        "    print(src, ':', classify(src))"
      ],
